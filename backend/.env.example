# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/theft_detection
# For SQLite (development): DATABASE_URL=sqlite:///./theft_detection.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# File Storage
UPLOAD_DIR=../data/uploads
EVIDENCE_SNAPSHOTS_DIR=../data/evidence/snapshots
EVIDENCE_CLIPS_DIR=../data/evidence/clips

# ML Models
YOLO_MODEL_PATH=../ml_models/yolov8n.pt

# Detection Settings
PERSON_CONFIDENCE_THRESHOLD=0.5
VIDEO_PROCESSING_FPS=10
SUSPICION_SCORE_THRESHOLD=70

# Behavior Scoring Weights
SCORE_BASE_SHELF_PICKUP=30
SCORE_SHELF_TO_POCKET=40
SCORE_SHELF_TO_BAG=20
SCORE_REPEATED_TOUCH=10
SCORE_ABNORMAL_MOTION=10

# Evidence Settings
CLIP_DURATION_BEFORE=5
CLIP_DURATION_AFTER=5
